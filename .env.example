# Copy this file to ".env" (next to docker-compose.yml) and fill it in.

# Access token. Required when Moki is exposed to the network (e.g. a Raspberry Pi).
# Generate one with:  openssl rand -hex 24
MOKI_TOKEN=

# IP or hostname you use to reach the Pi (e.g. 192.168.1.50 or raspberrypi.local).
# Used for the URLs returned by the MCP and to validate the Host header.
MOKI_PI_HOST=raspberrypi.local
# Port published on the Pi.
MOKI_PI_PORT=7410

# Accepted hosts (comma-separated; no port = any port; "*" = any host).
# Defaults to MOKI_PI_HOST. Add the IP and your VPN/Tailscale name if you use them.
# MOKI_ALLOWED_HOSTS=raspberrypi.local,192.168.1.50,moki-pi.tailnet-xxxx.ts.net

# --- Memory (docker-compose.pi.yml already enables the MOKI_LOW_MEMORY=1 profile) ---
# Chromium runtime pages at the same time (one per file an agent is working on).
# MOKI_MAX_RUNTIMES=2
# Close an unused runtime after (ms).
# MOKI_RUNTIME_IDLE_MS=300000
# Close the unused capture page after (ms).
# MOKI_CAPTURE_IDLE_MS=120000
# Close Chromium entirely when no page is left (ms).
# MOKI_BROWSER_IDLE_MS=180000
# Maximum side of a raster export (px).
# MOKI_MAX_EXPORT_SIDE=8000
# Container memory limit, and memory + swap.
# MOKI_MEM_LIMIT=2560m
# MOKI_MEMSWAP_LIMIT=3584m
# Extra Chromium flags, space-separated.
# MOKI_CHROMIUM_ARGS=

# Path on the Pi where exports end up (the filePath the agent will see).
# MOKI_EXPORT_HOST_DIR=/home/pi/moki/data/exports
