# Copy this file to `deploy.local.env` (ignored by git) and fill it in with your Raspberry Pi.
# Read by scripts/deploy/*.sh. Never put passwords or tokens here: access is via ssh key.

# ssh target: user@host or an alias from ~/.ssh/config.
MOKI_DEPLOY_SSH=pi@raspberrypi.local

# Moki folder on the Raspberry Pi.
MOKI_DEPLOY_DIR=/home/pi/moki

# URL you use to reach Moki from this machine (used to check the deployment).
MOKI_DEPLOY_URL=http://raspberrypi.local:7410

# Optional: deployment profile. `pi` (default) uses docker-compose.pi.yml (low-memory profile);
# `server` uses docker-compose.server.yml for an always-on machine with spare RAM (e.g. a Mac mini
# with OrbStack).
# MOKI_DEPLOY_PROFILE=pi

# Optional: extra hostnames/IPs you use to reach the Pi (LAN IP, hostname, VPN).
# MOKI_ALLOWED_HOSTS=raspberrypi.local,192.168.1.50
# Optional: container memory limit written by setup-secrets.sh (default 1536m; 6g for `server`).
# MOKI_MEM_LIMIT=1536m
